{
  "name": "core-guitar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "npm run build && npm run backend",
    "dev": "npm --prefix web run dev",
    "backend": ".venv/bin/coreguitar serve",
    "build": "npm --prefix web run build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": ".venv/bin/python -m pytest",
    "test:frontend": "npm --prefix web test",
    "typecheck": "npm --prefix web run typecheck",
    "lint": "npm --prefix web run lint",
    "e2e": "npm --prefix web run e2e"
  }
}
